<UserControl
    x:Class="Files.App.Views.Shells.XpExplorerShell"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Files.App.Views.Shells">

    <!--
        The Explorer shell owns every top-level band.  Children may overlay only
        within their own region; regular chrome never spans across these rows.
    -->
    <Grid x:Name="ShellRoot" Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="26" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentPresenter x:Name="TitleTabHost" Grid.Row="0" Content="{x:Bind TitleTabContent, Mode=OneWay}" />

        <Border
            Grid.Row="1"
            Background="{ThemeResource App.Theme.Toolbar.BackgroundBrush}"
            BorderBrush="#FFACA899"
            BorderThickness="0,0,0,1">
            <ContentPresenter x:Name="MenuHost" Content="{x:Bind MenuContent, Mode=OneWay}" />
        </Border>

        <Border
            Grid.Row="2"
            Background="{ThemeResource App.Theme.Toolbar.BackgroundBrush}"
            BorderBrush="#FFACA899"
            BorderThickness="0,0,0,1">
            <ContentPresenter x:Name="NavigationHost" Content="{x:Bind NavigationContent, Mode=OneWay}" />
        </Border>

        <ContentPresenter x:Name="NotificationHost" Grid.Row="3" Content="{x:Bind NotificationContent, Mode=OneWay}" />
        <ContentPresenter x:Name="WorkspaceHost" Grid.Row="4" Content="{x:Bind WorkspaceContent, Mode=OneWay}" />
        <ContentPresenter x:Name="StatusHost" Grid.Row="5" Content="{x:Bind StatusContent, Mode=OneWay}" />
    </Grid>
</UserControl>
