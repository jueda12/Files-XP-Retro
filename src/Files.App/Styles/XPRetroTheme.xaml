<!--  Unofficial Windows XP-inspired palette for the Files XP Retro fork.  -->
<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<ResourceDictionary.ThemeDictionaries>
		<ResourceDictionary x:Key="Light">
			<Color x:Key="AccentFillColorDefault">#FF245EDC</Color>
			<Color x:Key="AccentFillColorSecondary">#FF316AC5</Color>
			<Color x:Key="AccentFillColorTertiary">#FF1C4FA1</Color>
			<SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#FF245EDC" />
			<SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#FF316AC5" />
			<SolidColorBrush x:Key="AccentFillColorTertiaryBrush" Color="#FF1C4FA1" />

			<Color x:Key="ControlFillColorDefault">#FFECE9D8</Color>
			<Color x:Key="ControlFillColorSecondary">#FFF5F3E8</Color>
			<Color x:Key="ControlFillColorTertiary">#FFD4D0C8</Color>
			<SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#FFECE9D8" />
			<SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#FFF5F3E8" />
			<SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#FFD4D0C8" />

			<Color x:Key="ControlStrokeColorDefault">#FF7F9DB9</Color>
			<Color x:Key="ControlStrokeColorSecondary">#FFFFFFFF</Color>
			<SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#FF7F9DB9" />
			<SolidColorBrush x:Key="ControlStrokeColorSecondaryBrush" Color="#FFFFFFFF" />

			<Color x:Key="CardBackgroundFillColorDefault">#FFFFFFFF</Color>
			<Color x:Key="CardBackgroundFillColorSecondary">#FFECE9D8</Color>
			<Color x:Key="CardStrokeColorDefault">#FFACA899</Color>
			<SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#FFFFFFFF" />
			<SolidColorBrush x:Key="CardBackgroundFillColorSecondaryBrush" Color="#FFECE9D8" />
			<SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#FFACA899" />
			<SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#FFFFFFFF" />

			<Color x:Key="SubtleFillColorSecondary">#FFD6E6FF</Color>
			<Color x:Key="SubtleFillColorTertiary">#FFB8CDF5</Color>
			<SolidColorBrush x:Key="SubtleFillColorSecondaryBrush" Color="#FFD6E6FF" />
			<SolidColorBrush x:Key="SubtleFillColorTertiaryBrush" Color="#FFB8CDF5" />

			<Color x:Key="TextFillColorPrimary">#FF000000</Color>
			<Color x:Key="TextFillColorSecondary">#FF404040</Color>
			<Color x:Key="AccentTextFillColorPrimary">#FF003399</Color>
			<SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FF000000" />
			<SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#FF404040" />
			<SolidColorBrush x:Key="AccentTextFillColorPrimaryBrush" Color="#FF003399" />
			<SolidColorBrush x:Key="DividerStrokeColorDefaultBrush" Color="#FFC6C2B8" />

			<!-- WinUI's MenuBarItem template puts Title in ContentButton and reads this resource for its padding. -->
			<Thickness x:Key="MenuBarItemButtonPadding">8,0,8,0</Thickness>
		</ResourceDictionary>
	</ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
